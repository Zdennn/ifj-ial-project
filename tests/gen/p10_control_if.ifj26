import ifj26.*

def abs(x: Int): Int =
  if x < 0 then
    0 - x
  else
    x

def sign(x: Int): Int = if x < 0 then 0 - 1 else if x == 0 then 0 else 1

@main def run(): Unit =
  val x = 0 - 5
  val a = if x < 0 then 0 - x else x
  print(toStr(a))
  val b = if x > 0 then 1 else
      2
  print(toStr(b))
  print(toStr(abs(x)))
  print(toStr(sign(x)))
  print(toStr(sign(0)))
  print(toStr(sign(7)))
  val d = if x < 0 then 1 else 2.5
  print(toStr(d))
  if x > 0 then print("P")
  print(".")
