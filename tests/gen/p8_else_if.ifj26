import ifj26.*

def f(x: Int): Unit =
  if x < 0 then
    print("n")
  else if x == 0 then
    print("z")
  else if x < 10 then
    print("m")
  else
    print("v")

@main def run(): Unit =
  val a = 0 - 5
  f(a)
  f(0)
  f(4)
  f(40)
  if 1 > 2 then
    print("A")
  else if 1 > 3 then
    print("B")
  print(".")
