import ifj26.*

@main def run(): Unit =
  for i <- 1 to 5 do print(toStr(i))
  print(" ")
  for i <- 1 until 5 do print(toStr(i))
  print(" ")
  for i <- 1 to 10 by 3 do print(toStr(i))
  print(" ")
  for i <- 5 to 1 by 0 - 2 do print(toStr(i))
  print(" ")
  for i <- 1 to 10 if i > 3 if i < 7 do print(toStr(i))
  print(" ")
  for i <- 1 to 3 do
    for j <- 1 until 3 do print(toStr(i * 10 + j))
  print(".")
