import ifj26.*

extension (value: Int)
  def twice: Int = value * 2
  def foo(): String = "foo" + value.toString
  def plus(other: Int): Int = value + other

@main def run(): Unit =
  val x: Int = 6
  val y = x.twice
  val z = x.foo()
  val w = x.plus(12)
  print(toStr(y))
  print(" ")
  print(z)
  print(" ")
  print(toStr(w))
  print(" ")
  print(toStr(x.plus(1).twice))
  print(".")
